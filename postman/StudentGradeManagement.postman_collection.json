{
  "info": {
    "name": "Student Grade Management API",
    "description": "Set baseUrl and the demonstration account variables before running. Requests intentionally exercise validation, remark tampering, authorization, and student ownership.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://YOUR-RENDER-SERVICE.onrender.com" },
    { "key": "facultyEmail", "value": "faculty@example.test" },
    { "key": "facultyPassword", "value": "" },
    { "key": "studentEmail", "value": "student@example.test" },
    { "key": "studentPassword", "value": "" },
    { "key": "expectedStudentNumber", "value": "2026-0001" },
    { "key": "facultyToken", "value": "" },
    { "key": "studentToken", "value": "" },
    { "key": "studentId", "value": "" },
    { "key": "otherStudentId", "value": "999999" },
    { "key": "gradeId", "value": "" }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Faculty login - issue JWT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{facultyEmail}}\",\"password\":\"{{facultyPassword}}\"}" },
            "url": "{{baseUrl}}/api/auth/token"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Faculty token issued', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('facultyToken', pm.response.json().accessToken);"] } }]
        },
        {
          "name": "Student login - issue JWT",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"email\":\"{{studentEmail}}\",\"password\":\"{{studentPassword}}\"}" },
            "url": "{{baseUrl}}/api/auth/token"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student token issued', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.collectionVariables.set('studentToken', pm.response.json().accessToken);"] } }]
        },
        {
          "name": "Protected grades without token - 401",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/grades"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Unauthenticated request is denied', () => pm.response.to.have.status(401));"] } }]
        }
      ]
    },
    {
      "name": "Faculty - CRUD and validation",
      "item": [
        {
          "name": "List faculty grade records",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{facultyToken}}" }],
            "url": "{{baseUrl}}/api/grades"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Faculty can list grades', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "List students and select a test student",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{facultyToken}}" }],
            "url": "{{baseUrl}}/api/grades/students"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Faculty can list active students', () => pm.response.to.have.status(200));", "if (pm.response.code === 200 && pm.response.json().length) {", "  const students = pm.response.json();", "  pm.collectionVariables.set('studentId', students[0].studentId);", "  pm.collectionVariables.set('otherStudentId', students.length > 1 ? students[1].studentId : 999999);", "}"] } }]
        },
        {
          "name": "Create test subject before grade CRUD",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{facultyToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"subjectCode\":\"POSTMAN-TEST\",\"subjectName\":\"API Test Record\"}" },
            "url": "{{baseUrl}}/api/grades/subjects"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Test subject is available for grade CRUD', () => pm.expect([201, 409]).to.include(pm.response.code));"] } }]
        },
        {
          "name": "Create grade with a false client remark",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{facultyToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"studentId\":{{studentId}},\"subjectCode\":\"POSTMAN-TEST\",\"subjectName\":\"API Test Record\",\"grade\":98,\"remarks\":\"TAMPERED\",\"semester\":\"Postman Test\",\"schoolYear\":\"2099-2100\"}" },
            "url": "{{baseUrl}}/api/grades"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Grade created', () => pm.response.to.have.status(201));", "if (pm.response.code === 201) {", "  const record = pm.response.json();", "  pm.collectionVariables.set('gradeId', record.gradeId);", "  pm.test('Server ignores false remark', () => pm.expect(record.remarks).to.eql('CMS'));", "}"] } }]
        },
        {
          "name": "Get one grade",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{facultyToken}}" }],
            "url": "{{baseUrl}}/api/grades/{{gradeId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Faculty can get an individual grade', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Update grade and recalculate remark",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{facultyToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"studentId\":{{studentId}},\"subjectCode\":\"POSTMAN-TEST\",\"subjectName\":\"API Test Record\",\"grade\":88,\"remarks\":\"CMS\",\"semester\":\"Postman Test\",\"schoolYear\":\"2099-2100\"}" },
            "url": "{{baseUrl}}/api/grades/{{gradeId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Grade updated', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.test('Remark matches updated grade', () => pm.expect(pm.response.json().remarks).to.eql('SAP'));"] } }]
        },
        {
          "name": "Reject grade 105",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{facultyToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"studentId\":{{studentId}},\"subjectCode\":\"BAD105\",\"subjectName\":\"Invalid\",\"grade\":105,\"semester\":\"Test\",\"schoolYear\":\"2099-2100\"}" },
            "url": "{{baseUrl}}/api/grades"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Grade above 100 rejected', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Reject grade -1",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{facultyToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"studentId\":{{studentId}},\"subjectCode\":\"BADNEG\",\"subjectName\":\"Invalid\",\"grade\":-1,\"semester\":\"Test\",\"schoolYear\":\"2099-2100\"}" },
            "url": "{{baseUrl}}/api/grades"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Negative grade rejected', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Reject non-integer grade",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{facultyToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"studentId\":{{studentId}},\"subjectCode\":\"BADFRAC\",\"subjectName\":\"Invalid\",\"grade\":84.5,\"semester\":\"Test\",\"schoolYear\":\"2099-2100\"}" },
            "url": "{{baseUrl}}/api/grades"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Fractional grade rejected', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Delete test grade",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{facultyToken}}" }],
            "url": "{{baseUrl}}/api/grades/{{gradeId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Grade deleted', () => pm.response.to.have.status(204));"] } }]
        }
      ]
    },
    {
      "name": "Student - ownership and write restrictions",
      "item": [
        {
          "name": "Read own grades; attempt query-string override",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/student/grades?studentId={{otherStudentId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student can read own grades', () => pm.response.to.have.status(200));", "if (pm.response.code === 200) pm.test('All rows belong to signed-in student', () => pm.response.json().forEach(row => pm.expect(row.studentNumber).to.eql(pm.collectionVariables.get('expectedStudentNumber'))));"] } }]
        },
        {
          "name": "Student cannot list all faculty grades",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/grades"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student role is forbidden', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Student cannot create grades",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"studentId\":{{studentId}},\"subjectCode\":\"STUDENT-WRITE\",\"subjectName\":\"Forbidden\",\"grade\":99,\"semester\":\"Test\",\"schoolYear\":\"2099-2100\"}" },
            "url": "{{baseUrl}}/api/grades"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student POST is forbidden', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Student cannot update grades",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }, { "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"studentId\":{{studentId}},\"subjectCode\":\"POSTMAN-TEST\",\"subjectName\":\"Tampered\",\"grade\":100,\"semester\":\"Test\",\"schoolYear\":\"2099-2100\"}" },
            "url": "{{baseUrl}}/api/grades/{{gradeId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student PUT is forbidden', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Student cannot delete grades",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{studentToken}}" }],
            "url": "{{baseUrl}}/api/grades/{{gradeId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('Student DELETE is forbidden', () => pm.response.to.have.status(403));"] } }]
        }
      ]
    }
  ]
}
